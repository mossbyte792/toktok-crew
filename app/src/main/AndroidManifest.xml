<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos 문서: pleos.car.permission.{CAR_*}. Seat=CAR_SEATS, Safety=CAR_SAFETY.
         Gear는 매핑표에 없어 CAR_DRIVE를 함께 선언해 시험한다(필요 여부는 로그로 확인). -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 2026-11-15 r6 4절: 뒷문 열림 읽기(Door.getCurrentDoorPosition·registerDoorPosition의 @RequiresPermission).
         에뮬 pm list permissions에서 protectionLevel normal(QA 실측). 읽기만 — CONTROL_CAR_DOORS는 선언하지 않는다 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- Telltale API(getTelltalesInfo/registerTelltales)가 SecurityException(need Permission)을 내서 시험 중.
         SDK 내부 SafetyImpl에 PRIVATE_CAR_SAFETY 문자열이 있어 선언해 본다. 마켓 배포 승인 가능 여부는 별도 확인 필요 -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 결정 39 취소(사용자, 11-15): 내비 경로 안내를 끝내지 않는다(cancelRoute 제거) → NAVI_ROUTE_SEARCH 권한도 뺐다.
         결정 41의 경로 상태 조회(getRouteStateInfo)는 위 NAVI_ROUTE 권한으로 된다(SDK 바이트코드 manager.c.s()의 권한 검사) -->
    <!-- 2026-11-13 ISSUE-07(사용자 결정 D-1): 이동 중(확인 완료~이동 끝)에만 foreground service로 앱 동결을 막는다.
         FOREGROUND_SERVICE(일반 권한), Android 14 타입별 권한 specialUse, 알림 표시(Android 13+ 런타임 권한, 거부해도 서비스는 돈다) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 2026-11-15 r10 B(사용자 결정): 자동 켜기(r7 5절, 임시 결정 50)를 끈다. 부팅 완료 권한(RECEIVE_BOOT_COMPLETED)과 아래 부팅 수신기(AutoOpenReceiver)를 뺐다.
         코드(AutoOpenRule·AutoOpenWatcher·AutoOpenNotice·AutoOpenReceiver)는 남겼다. 되돌리기: 이 자리에 uses-permission RECEIVE_BOOT_COMPLETED 한 줄,
         application 안에 receiver AutoOpenReceiver(intent-filter BOOT_COMPLETED, exported=true)를 다시 넣고 AutoOpenRule.ENABLED·SETTING_VISIBLE,
         PrivacyNotice.AUTO_OPEN_ENABLED_IN_NOTICE를 true로(원래 줄은 커밋 8f87871). 서비스 specialUse 설명의 (2) 문장도 함께 되돌린다 -->

    <!-- 2026-11-13 B: 확인 완료 뒤 내비 앱을 앞으로 띄운다(Pleos 내비, adb 확인). startActivity에는 필요 없지만
         패키지 조회(resolveActivity)로 내비 유무를 로그에 남기기 위해 선언한다 -->
    <queries>
        <package android:name="ai.umos.maps.android.navigation.app" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="톡톡크루"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- 2026-11-07 Unit 5.1: 플랫폼 주행 제한(CarUxRestrictionsManager) 읽기. 없는 기기에서도 설치되게 required=false,
             없으면 앱이 NOT_INTEGRATED로 보고 정차 조작을 열지 않는다 -->
        <uses-library android:name="android.car" android:required="false" />
        <!-- 2026-11-08 Unit 5.3: Pleos 런처(독)로 복귀하면 standard 모드에서는 기존 화면 위에 새 MainActivity가 하나 더 생겼다
             (차량 리스너·TTS·감시 세션이 두 벌, 이벤트 중복). singleTask로 기존 화면을 앞으로 가져온다 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- r10 B: 부팅 수신기(AutoOpenReceiver)는 뺐다(위 권한 주석의 되돌리기 참고) -->
        <!-- 2026-11-13 ISSUE-07: 이동 중에만 켜는 서비스. SDK 리스너는 Activity가 갖고, 이 서비스는 동결만 막는다(외부 노출 없음).
             r7 5절의 '자동 열기' 모드(ACTION_AUTO_OPEN)는 r10 B로 부팅 수신기를 빼서 시작되지 않는다(코드만 남음).
             r10 H: 확인 완료 뒤 10분 출발 없음·하차 안내 뒤 유효 P 30분이면 서비스를 끝낸다(TripCapRule) -->
        <service
            android:name=".TripKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="In-car family trip guide. While a trip is active (from the seat/seat-belt signal check until arrival and exit), keep the app process from being frozen so vehicle seat, gear and navigation time callbacks arrive on time and short voice guidance (departure, ETA, arrival, exit check) can play while the navigation app is in front. Stops when the trip ends, when the car does not start driving within 10 minutes after the check, or after 30 minutes parked at the stop once exit reminders are done. Reads no location. No microphone or network use by this service." />
        </service>
    </application>
</manifest>
